{
  "manifest_version": 3,
  "name": "Thanos Snap",
  "version": "0.1.0",
  "description": "Snap your fingers and turn to dust on your webcam.",
  "permissions": ["storage"],
  "action": { "default_popup": "popup/popup.html" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["inject.js"], "run_at": "document_start", "all_frames": true, "world": "MAIN" },
    { "matches": ["<all_urls>"], "js": ["bridge.js"], "run_at": "document_start", "all_frames": true }
  ],
  "web_accessible_resources": [
    { "resources": ["mediapipe/*"], "matches": ["<all_urls>"] }
  ]
}
